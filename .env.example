# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional but recommended: a random string used to verify that webhook
# requests are really coming from Telegram (see README "Securing the webhook")
TELEGRAM_WEBHOOK_SECRET=

# Optional: if set, the bot will only respond to messages from this chat ID
# (Meera's personal chat with the bot). Leave blank while testing, lock it
# down once you know her chat ID.
ALLOWED_CHAT_ID=
