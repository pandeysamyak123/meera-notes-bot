# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-3.1-flash-lite

# Supabase project used for the notes/drafts/voice-skill tables
# (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_KEY=

# Base URL of your deployed app - used to build the LinkedIn connect/callback
# links (e.g. https://meera-notes-bot.vercel.app)
APP_BASE_URL=

# From your LinkedIn Developer App (see README "Connect LinkedIn")
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional - only needed to run scripts/compare-models.js
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional but recommended: a random string used to verify that webhook
# requests are really coming from Telegram (see README "Securing the webhook")
TELEGRAM_WEBHOOK_SECRET=

# Optional: if set, the bot will only respond to messages from this chat ID
# (Meera's personal chat with the bot). Leave blank while testing, lock it
# down once you know her chat ID.
ALLOWED_CHAT_ID=
